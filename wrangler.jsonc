{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "running-tab",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/pay/*", "/paypal/*", "/webhooks/*", "/health", "/desk/config"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "running-tab", "database_id": "0f7feed6-1666-404d-ac1b-006b6c778b86", "migrations_dir": "migrations" },
    // The shared ledger of every hackathon app's model calls (table ai_calls).
    { "binding": "LEDGER", "database_name": "hackathon-ledger", "database_id": "023377a8-ad19-413c-b769-d195d05427b3" }
  ],
  "kv_namespaces": [
    { "binding": "RT_KV", "id": "46ddec817f0146eba24cd27a3d0c3c5b" }
  ],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["17 7 * * *"] },
  "vars": {
    "PAYPAL_BASE": "https://api-m.sandbox.paypal.com",
    "AI_MODE": "live"
  },
  "observability": { "enabled": true },
  // Local runs only: no Workers AI binding, so a local run can never reach any account's model pool.
  "env": {
    "local": {
      "d1_databases": [
        { "binding": "DB", "database_name": "running-tab", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
      ],
      "kv_namespaces": [{ "binding": "RT_KV", "id": "00000000000000000000000000000000" }],
      "vars": { "PAYPAL_BASE": "https://api-m.sandbox.paypal.com", "AI_MODE": "replay" }
    }
  }
}
